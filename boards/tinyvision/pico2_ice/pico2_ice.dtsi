#include <freq.h>

#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

#include "pico2_ice-pinctrl.dtsi"

/ {
	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,code-partition = &code_partition;
	};

	leds {
		compatible = "gpio-leds";
		led0_red: led_0 {
			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
			label = "Red LED 0";
		};
		led1_green: led_1 {
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			label = "Green LED 1";
		};
		led2_blue: led_2 {
			gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
			label = "Blue LED 2";
		};
	};

	pwmleds {
		compatible = "pwm-leds";
		pwm_led0_red: pwm_led_0 {
			pwms = <&pwm 1 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
			label = "Red PWM LED 0";
		};
		pwm_led1_green: pwm_led_1 {
			pwms = <&pwm 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
			label = "Green PWM LED 1";
		};
		pwm_led2_blue: pwm_led_2 {
			pwms = <&pwm 9 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
			label = "Blue PWM LED 2";
		};
	};

	/* As to not interfere with FPGA flash boot,
	 * the CRAM interface is a deferred init.
	 * To use the FPGA CRAM, it needs to be initialized
	 */
	spi_fpga: spi_bitbang {
		compatible = "zephyr,spi-bitbang";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		clock-frequency = <DT_FREQ_M(1)>;
		clk-gpios = <&gpio0 6 0>;
		mosi-gpios = <&gpio0 4 0>;
		cs-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
		zephyr,deferred-init;

		fpga0: ice40@0 {
			status = "okay";
			compatible = "lattice,ice40-fpga";
			reg = <0x0>;
			spi-max-frequency = <DT_FREQ_M(1)>;

			cdone-gpios = <&gpio0 40 0>;
			creset-gpios = <&gpio0 31 0>;
			config-delay-us = <3900>;
		};
	};

	aliases {
		watchdog0 = &wdt0;
		led0 = &led0_red;
		led1 = &led1_green;
		led2 = &led2_blue;
		pwm-led0 = &pwm_led0_red;
		pwm-led1 = &pwm_led1_green;
		pwm-led2 = &pwm_led2_blue;
		green-pwm-led = &pwm_led1_green;
		red-pwm-led = &pwm_led0_red;
		blue-pwm-led = &pwm_led2_blue;
		fpga = &fpga0;
	};
};

&flash0 {
	reg = <0x10000000 DT_SIZE_M(4)>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* Reserved memory for an image definition block. The block is much
		 * smaller than 256 bytes, but in practice the linker places the vector
		 * table at a much larger alignment offset.
		 */
		image_def: partition@0 {
			label = "image_def";
			reg = <0x00000000 0x100>;
			read-only;
		};

		/*
		 * Usable flash. Starts at 0x100, after the image definition block.
		 * The partition size is 4MB minus the 0x100 bytes taken by the
		 * image definition.
		 */
		code_partition: partition@100 {
			label = "code-partition";
			reg = <0x100 (DT_SIZE_M(4) - 0x100)>;
			read-only;
		};
	};
};

gpio0_lo: &gpio0 {
	status = "okay";
};

&gpio0_hi {
	status = "okay";
};

&clocks {
	pinctrl-0 = <&fpga_gpout0>;
	pinctrl-names = "default";
};

&clk_gpout0 {
	clocks = <&pll_usb>;
	clock-names = "pll_usb";
	clock-frequency = <48000000>;
};

&pwm {
	status = "okay";
	pinctrl-0 = <&pwm_rgbled_default>;
	pinctrl-names = "default";
	divider-int-0 = <255>;
};

&timer0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

zephyr_udc0: &usbd {
	status = "okay";
};
#include <../boards/common/usb/cdc_acm_serial.dtsi>
