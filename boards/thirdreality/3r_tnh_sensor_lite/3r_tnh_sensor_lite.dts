/dts-v1/;

#include <bflb/bl704l.dtsi>
#include "3r_tnh_sensor_lite-pinctrl.dtsi"

/ {
	model = "ThirdReality Temperature and Humidity Sensor Lite";
	compatible = "bflb,bl704l";

	chosen {
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,itcm = &itcm;
		zephyr,sram = &sram0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	aliases {
		led0 = &blue_led;
		sw0 = &button_0;
	};

	leds {
		compatible = "gpio-leds";

		blue_led: led_0 {
			gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
			label = "Blue - LED0";
		};

		red_led: led_1 {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
			label = "Red - LED1";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button_0: sw0 {
			gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(128)>;
};

&flashctrl {
	flash0: flash@23000000 {
		compatible = "soc-nv-flash", "zb,zb25d80d";
		reg = <0x23000000 (0x200000 - 0x2000)>;
		write-block-size = <256>;
		erase-block-size = <DT_SIZE_K(4)>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			slot0_partition: partition@0 {
				label = "image-0";
				reg = <0x00000000 0x100000>;
				read-only;
			};

			storage_partition: partition@100000 {
				label = "storage";
				reg = <0x00100000 (0x100000 - 0x2000)>;
			};
		};
	};
};

&gpio0 {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;

	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	sht4x@44 {
		status = "okay";
		compatible = "sensirion,sht4x";
		reg = <0x44>;
		repeatability = <2>;
	};
};
