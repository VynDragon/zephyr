if SOC_FAMILY_BFLB

config MAIN_STACK_SIZE
	default 4096

DT_CHOSEN_BFLB_HEAP_RAM := bflb,heap-ram
DT_CHOSEN_BFLB_HEAP_PSRAM := bflb,heap-psram

configdefault MBEDTLS_HEAP_CUSTOM_SECTION
	default y if $(dt_chosen_enabled,$(DT_CHOSEN_BFLB_HEAP_RAM))
	default y if $(dt_chosen_enabled,$(DT_CHOSEN_BFLB_HEAP_PSRAM)) && MEMC

rsource "*/Kconfig.defconfig"

endif # SOC_FAMILY_BFLB
