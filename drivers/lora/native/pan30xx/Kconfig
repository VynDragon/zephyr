config LORA_PAN30XX_NATIVE
	bool "Panchip PAN30xx native driver (experimental)"
	default y
	depends on LORA_MODULE_BACKEND_NATIVE
	depends on DT_HAS_PANCHIP_PAN3029_ENABLED || DT_HAS_PANCHIP_PAN3060_ENABLED
	select SPI if $(dt_compat_on_bus,$(DT_COMPAT_PANCHIP_PAN3029),spi)
	select I2C if $(dt_compat_on_bus,$(DT_COMPAT_PANCHIP_PAN3029),i2c)
	select SPI if $(dt_compat_on_bus,$(DT_COMPAT_PANCHIP_PAN3060),spi)
	select I2C if $(dt_compat_on_bus,$(DT_COMPAT_PANCHIP_PAN3060),i2c)
	select GPIO
	help
	  Enable native driver for Panchip PAN30xx ChirpIoT transceivers.
	  This is an experimental driver that does not depend on loramac-node
	  or lora-basics-modem external modules.

config LORA_PAN30XX_NATIVE_SLEEP
	bool "Sleep mode power management"
	default y
	depends on LORA_PAN30XX_NATIVE
	help
	  Place the PAN30xx radio into sleep mode when idle to reduce
	  power consumption (~620 nA vs an unspecified amount in standby).
	  Disable to keep the radio in standby for faster response times.
